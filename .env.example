# ── 本機開發用 .env（不要 commit 到 git）─────────────────────────────────────
# 本機透過 cloud-sql-proxy 連線時使用 localhost
# DB_URL=postgresql+asyncpg://ots_app:YOUR_PASSWORD@localhost:5433/ots

# Cloud Run / Cloud Shell 環境下使用 Unix socket
DB_URL=postgresql+asyncpg://ots_app:YOUR_PASSWORD@/ots?host=/cloudsql/ots-translation:asia-east1:ots-db-dev

PROJECT_ID=ots-translation
ENV=dev

GCS_UPLOADS_BUCKET=ots-translation-uploads-dev
GCS_OUTPUTS_BUCKET=ots-translation-outputs-dev
GCS_TEMP_BUCKET=ots-translation-pipeline-temp-dev
PUBSUB_TOPIC=ots-pipeline-trigger-dev

# ── Payment gateway ──────────────────────────────────────────────────────────
# manual（預設，手動確認匯款） / ecpay / payuni / stripe
PAYMENT_GATEWAY=manual

# ── Stripe（海外信用卡）───────────────────────────────────────────────────────
# PAYMENT_GATEWAY=stripe 時需要；Cloud Run 部署時透過 Secret Manager 注入
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Service Account email（Signed URL 簽名用，通常由 metadata server 自動取得）
# SERVICE_ACCOUNT_EMAIL=ots-api-backend-dev@ots-translation.iam.gserviceaccount.com

# ECPay sandbox（測試環境）
ECPAY_SANDBOX=true
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS

# Gemini API（試譯包 synopsis 生成）
# 1. 前往 https://aistudio.google.com/apikey 建立 API Key
# 2. 貼到下面（開發環境複製 .env.example → .env 貼上）
# 3. Cloud Run 部署時透過 Secret Manager 注入
# GEMINI_API_KEY=your_key_here

# ── Email 通知（開發環境用 SMTP / Mailpit / Mailhog）────────────────────────
# 生產環境使用 Brevo：EMAIL_PROVIDER=brevo + BREVO_API_KEY
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@ots.tw
EMAIL_FROM_NAME=OTS 翻譯服務
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# SMTP_USE_TLS=false

# Brevo（生產環境用）
# BREVO_API_KEY=your_brevo_api_key

# ── Frontend Portal URL（email 中的連結基礎 URL）─────────────────────────────
WEB_PORTAL_URL=http://localhost:3000

# ── Notification Pub/Sub ──────────────────────────────────────────────────────
NOTIFY_TOPIC=ots-notify-dev

# ── BRONCI TTS（影片分鏡語音生成）───────────────────────────────────────────────
# Cloud Run 部署時透過 Secret Manager 注入（ots-bronci-username-{env} 等）
# 開發環境直接填入下方
# BRONCI_API_USERNAME=your_username
# BRONCI_API_PASSWORD=your_password
# BRONCI_API_BASE_URL=https://rbtttsapi.bronci.com.tw

# ── Hugging Face Inference API（影片分鏡圖片生成）────────────────────────────────
# Cloud Run 部署時透過 Secret Manager 注入（ots-hf-api-token-{env}）
# HF_API_TOKEN=hf_your_token
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# -- NVIDIA build.nvidia.com (2nd fallback image gen) ---------------------
# Cloud Run 部署時透過 Secret Manager 注入（ots-nvidia-api-token-{env}）
# NVIDIA_API_TOKEN=nvapi-your_token

# -- Replicate (3rd fallback image gen) ------------------------------------
# Cloud Run 部署時透過 Secret Manager 注入
# REPLICATE_API_TOKEN=r8_your_token

# -- fal.ai (LTX / PixVerse video gen) --------------------------------------
# Cloud Run 部署時透過 Secret Manager 注入
# FAL_API_KEY=your_fal_key
